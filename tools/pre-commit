#!/bin/sh
#
# Pre-commit hook:
# 1. Block commits on branches whose PR is already merged
# 2. Warn if evaluator/equiv files are being committed without /audit
# 3. Check for unused private declarations
# 4. Auto-update axiom/theorem counts in docs
#
# Install: ln -sf ../../tools/pre-commit .git/hooks/pre-commit

# --- Block commits on branches with merged PRs ---
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
case "$branch" in
  master|main) ;;
  *)
    if command -v gh >/dev/null 2>&1; then
      merged=$(gh pr list --head "$branch" --state merged --json number --jq '.[0].number' 2>/dev/null)
      if [ -n "$merged" ]; then
        printf >&2 "\n\033[1;31m✘ Branch '%s' already has a merged PR (#%s).\033[0m\n" "$branch" "$merged"
        printf >&2 "  Create a new branch from master:\n"
        printf >&2 "    git checkout master && git pull && git checkout -b claude/<new-task>\n\n"
        exit 1
      fi
    fi
    ;;
esac

AUDIT_FILES="
SqlEquiv/Semantics.lean
SqlEquiv/Ast.lean
SqlEquiv/Equiv.lean
"

AUDIT_DIRS="
SqlEquiv/Equiv/
"

staged=$(git diff --cached --name-only)
matched=""

for f in $AUDIT_FILES; do
    case "$staged" in
        *"$f"*) matched="$matched  $f\n" ;;
    esac
done

for d in $AUDIT_DIRS; do
    for f in $(echo "$staged" | grep "^$d"); do
        matched="$matched  $f\n"
    done
done

if [ -n "$matched" ]; then
    printf "\n\033[1;33m⚠  Evaluator/equiv files staged:\033[0m\n"
    printf '%b' "$matched"
    printf "\n\033[1;36m   Consider running /audit before committing.\033[0m\n\n"
fi

# --- Check for unused private declarations in staged Lean files ---
lean_staged=$(echo "$staged" | grep '^SqlEquiv/.*\.lean$' || true)
if [ -n "$lean_staged" ]; then
    printf "\033[1;36m   Checking for unused private declarations...\033[0m\n"
    if uv run python tools/unused_private_checker.py $lean_staged; then
        printf "\033[1;32m   ✓ No unused private declarations.\033[0m\n\n"
    else
        printf "\n\033[1;31m   ✗ Unused private declarations found — remove them before committing.\033[0m\n"
        printf "   Skip this check with: git commit --no-verify\n\n"
        exit 1
    fi
fi

# --- Auto-update axiom/theorem counts in docs ---
if [ -n "$lean_staged" ]; then
    printf "\033[1;36m   Updating doc axiom/theorem counts...\033[0m\n"
    if uv run python tools/update_doc_counts.py; then
        # Stage any doc files that were modified
        for doc in docs/PROVING_AXIOMS_PLAN.md docs/theorem_coverage_audit_plan.md tools/axiom_count_minimum.txt; do
            if git diff --name-only -- "$doc" | grep -q .; then
                git add "$doc"
                printf "   Auto-staged %s\n" "$doc"
            fi
        done
    fi
    printf "\n"
fi
