#!/bin/sh
#
# Pre-commit hook: warn if optimizer/evaluator files are being committed
# without running /audit for soundness checking.
#
# Install: ln -sf ../../tools/pre-commit .git/hooks/pre-commit

AUDIT_FILES="
SqlEquiv/Optimizer.lean
SqlEquiv/ExprNormalization.lean
SqlEquiv/PredicatePushdown.lean
SqlEquiv/OptimizerUtils.lean
SqlEquiv/Semantics.lean
SqlEquiv/Ast.lean
SqlEquiv/Equiv.lean
"

AUDIT_DIRS="
SqlEquiv/Equiv/
"

staged=$(git diff --cached --name-only)
matched=""

for f in $AUDIT_FILES; do
    case "$staged" in
        *"$f"*) matched="$matched  $f\n" ;;
    esac
done

for d in $AUDIT_DIRS; do
    for f in $(echo "$staged" | grep "^$d"); do
        matched="$matched  $f\n"
    done
done

if [ -n "$matched" ]; then
    printf "\n\033[1;33m⚠  Optimizer/evaluator files staged:\033[0m\n"
    printf "$matched"

    # Run rewrite audit validator automatically
    printf "\n\033[1;36m   Running rewrite audit validator...\033[0m\n\n"
    if python3 tools/rewrite_audit_validator.py; then
        printf "\n\033[1;32m   ✓ All rewrite arms annotated.\033[0m\n\n"
    else
        printf "\n\033[1;31m   ✗ Rewrite audit failed — fix unannotated arms before committing.\033[0m\n"
        printf "   Skip this check with: git commit --no-verify\n\n"
        exit 1
    fi
fi

# --- Auto-update axiom/theorem counts in docs ---
lean_staged=$(echo "$staged" | grep '^SqlEquiv/.*\.lean$' || true)
if [ -n "$lean_staged" ]; then
    printf "\033[1;36m   Updating doc axiom/theorem counts...\033[0m\n"
    if python3 tools/update_doc_counts.py; then
        # Stage any doc files that were modified
        for doc in docs/PROVING_AXIOMS_PLAN.md docs/theorem_coverage_audit_plan.md tools/axiom_count_minimum.txt; do
            if git diff --name-only -- "$doc" | grep -q .; then
                git add "$doc"
                printf "   Auto-staged %s\n" "$doc"
            fi
        done
    fi
    printf "\n"
fi
