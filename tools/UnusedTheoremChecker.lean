/-
  Unused Theorem Checker for sql_equiv

  Analyzes the Lean environment to find theorems in the SqlEquiv namespace
  that are not referenced by any other declaration (including tests).

  Uses `Expr.getUsedConstants` to build a reverse-dependency map, then reports
  any SqlEquiv theorem with zero external references.

  Usage: lake exe unused_theorem_checker
-/
import Lean
-- Build-dependency imports: ensures .oleans exist when `lake exe` runs.
-- The actual analysis loads these via `importModules` at runtime.
import SqlEquiv
import Test.ParserTest
import Test.SemanticsTest
import Test.EquivTest
import Test.PropertyTest
import Test.AxiomCoverageTest
import Test.Common
import LSpecTests.Generators
import LSpecTests.ExprAlgebra
import LSpecTests.NullSemantics
import LSpecTests.QueryHelpers
import LSpecTests.EdgeCaseDb
import LSpecTests.DiffSqlite

open Lean

/-- Check if `n` is in namespace `pfx` (e.g., `SqlEquiv.Equiv.foo` has prefix `SqlEquiv`). -/
partial def nameHasPrefix (n : Name) (pfx : Name) : Bool :=
  n == pfx ||
  match n with
  | .str parent _ => nameHasPrefix parent pfx
  | .num parent _ => nameHasPrefix parent pfx
  | .anonymous => false

/-- Check if a declaration belongs to the SqlEquiv namespace.
    Handles both public names (`SqlEquiv.foo`) and private names (`_private.SqlEquiv.foo`). -/
def isSqlEquivName (n : Name) : Bool :=
  nameHasPrefix n `SqlEquiv ||
  match privateToUserName? n with
  | some userName => nameHasPrefix userName `SqlEquiv
  | none => false

/-- Check if a theorem name is auto-generated by Lean (not hand-written).
    Filters: constructor injection, sizeOf specs, equation lemmas, brecOn, etc. -/
def isAutoGenerated (n : Name) : Bool :=
  match n with
  | .str parent s =>
    -- Direct suffix checks
    s == "inj" || s == "injEq" || s == "sizeOf_spec" || s == "eq_def" ||
    s == "noConfusion" || s == "noConfusionType" || s == "beq_spec" ||
    -- Equation lemmas: eq_1, eq_2, ...
    (s.startsWith "eq_" && (s.drop 3).toNat?.isSome) ||
    -- Auto-generated proof obligations: _proof_1, _proof_2, ...
    (s.startsWith "_proof_" && (s.drop 7).toNat?.isSome) ||
    -- Simp lemmas: _simp_1_1, etc.
    s.startsWith "_simp_" ||
    -- brecOn equation lemmas: Foo.brecOn.eq, Foo.brecOn_1.eq
    (s == "eq" && match parent with
      | .str _ ps => ps == "brecOn" || (ps.startsWith "brecOn_")
      | _ => false)
  | _ => false

/-- Convert a module name like `SqlEquiv.Equiv.ExprAxioms` to `SqlEquiv/Equiv/ExprAxioms.lean`. -/
def moduleNameToPath (n : Name) : String :=
  let rec go : Name → List String
    | .str parent s => go parent ++ [s]
    | .num parent i => go parent ++ [toString i]
    | .anonymous => []
  String.intercalate "/" (go n) ++ ".lean"

/-- Collect all constant names referenced by a `ConstantInfo` (from both type and value). -/
def collectDeps (info : ConstantInfo) : Array Name :=
  let typeDeps := info.type.getUsedConstants
  match info.value? with
  | some val => typeDeps ++ val.getUsedConstants
  | none => typeDeps

def main : IO UInt32 := do
  -- Initialize Lean search path (reads LEAN_PATH set by `lake exe`)
  initSearchPath (← findSysroot)

  -- Load environment with all project modules
  let modules : Array Import := #[
    { module := `SqlEquiv },
    { module := `Test.ParserTest },
    { module := `Test.SemanticsTest },
    { module := `Test.EquivTest },
    { module := `Test.PropertyTest },
    { module := `Test.AxiomCoverageTest },
    { module := `Test.Common },
    { module := `LSpecTests.Generators },
    { module := `LSpecTests.ExprAlgebra },
    { module := `LSpecTests.NullSemantics },
    { module := `LSpecTests.QueryHelpers },
    { module := `LSpecTests.EdgeCaseDb },
    { module := `LSpecTests.DiffSqlite }
  ]

  let env ← try
    importModules modules {}
  catch e =>
    IO.eprintln s!"Error loading modules: {e}"
    IO.eprintln "Make sure to build the project first: lake build && lake build sql_equiv_test && lake build sql_equiv_lspec"
    return (1 : UInt32)

  -- Step 1: Identify all SqlEquiv theorems (excluding auto-generated)
  let (theoremNames, totalDecls, autoGenCount) :=
    env.constants.fold (init := ((#[] : Array Name), (0 : Nat), (0 : Nat))) fun acc name info =>
      let (thms, count, autoCount) := acc
      let count' := count + 1
      if isSqlEquivName name then
        match info with
        | .thmInfo _ =>
          if isAutoGenerated name then
            (thms, count', autoCount + 1)
          else
            (thms.push name, count', autoCount)
        | _ => (thms, count', autoCount)
      else (thms, count', autoCount)

  -- Build set of theorem names for efficient lookup
  let theoremNameSet := theoremNames.foldl (init := NameSet.empty) fun s n => s.insert n

  -- Step 2: Build reverse dependency map (only tracking refs TO SqlEquiv theorems)
  let usedBy : NameMap (Array Name) :=
    env.constants.fold (init := {}) fun map name info =>
      let deps := collectDeps info
      deps.foldl (init := map) fun map dep =>
        if theoremNameSet.contains dep then
          let existing := match map.find? dep with
            | some arr => arr
            | none => #[]
          map.insert dep (existing.push name)
        else map

  -- Step 3: Categorize unreferenced theorems
  let mut unreferencedPrivate : Array (String × String) := #[]
  let mut unreferencedPublic : Array (String × String) := #[]
  let mut referencedCount : Nat := 0

  for thm in theoremNames do
    let refs := match usedBy.find? thm with
      | some arr => arr
      | none => #[]
    -- Filter out self-references
    let externalRefs := refs.filter (· != thm)
    if externalRefs.size == 0 then
      let modulePath := match env.getModuleIdxFor? thm with
        | some idx => moduleNameToPath env.header.moduleNames[idx.toNat]!
        | none => "<current module>"
      let displayName := match privateToUserName? thm with
        | some userName => s!"(private) {userName}"
        | none => toString thm
      if isPrivateName thm then
        unreferencedPrivate := unreferencedPrivate.push (modulePath, displayName)
      else
        unreferencedPublic := unreferencedPublic.push (modulePath, displayName)
    else
      referencedCount := referencedCount + 1

  -- Step 4: Sort results by module path, then name
  let sortedPrivate := unreferencedPrivate.qsort fun a b =>
    a.1 < b.1 || (a.1 == b.1 && a.2 < b.2)
  let sortedPublic := unreferencedPublic.qsort fun a b =>
    a.1 < b.1 || (a.1 == b.1 && a.2 < b.2)

  -- Step 5: Print report
  IO.println "=== Unused Theorem Report ==="
  IO.println s!"Found {theoremNames.size} hand-written theorems in SqlEquiv namespace"
  IO.println s!"  (plus {autoGenCount} auto-generated theorems, excluded from analysis)"
  IO.println s!"Scanned {totalDecls} total declarations for reverse dependencies (incl. tests)"
  IO.println ""

  if sortedPrivate.size > 0 then
    IO.println s!"--- Unreferenced private theorems (likely dead code): {sortedPrivate.size} ---"
    for entry in sortedPrivate do
      IO.println s!"  {entry.1}: {entry.2}"
    IO.println ""

  if sortedPublic.size > 0 then
    IO.println s!"--- Unreferenced public theorems (leaf API / user-facing): {sortedPublic.size} ---"
    for entry in sortedPublic do
      IO.println s!"  {entry.1}: {entry.2}"
    IO.println ""

  let totalUnreferenced := sortedPrivate.size + sortedPublic.size
  IO.println s!"Summary: {totalUnreferenced} unreferenced ({sortedPrivate.size} private, {sortedPublic.size} public leaf), {referencedCount} referenced"

  IO.println ""
  IO.println "Note: 3 sorry in Semantics.lean Block 1 — dependencies from sorry-containing"
  IO.println "proofs are partially captured (constants used before sorry are included)."

  return 0
