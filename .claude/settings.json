{
  "permissions": {
    "allow": [
      "Bash(python3 tools/axiom_coverage_validator.py --runtime --theorems:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 1800
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "Plan",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/ensure-fresh-branch.sh"
          }
        ]
      }
    ]
  }
}
